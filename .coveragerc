[run]
source = src
# Required to combine the coverage data of the integration shards, which run in
# different runners and therefore different absolute workspace paths.
relative_files = True

[report]
# Baseline measured on 2026-11-07 (88 %). It is a floor, not a target: raise it
# per milestone instead of jumping to a global 90 %.
fail_under = 85
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
