# =============================================================================
# Plantilla de entorno para DESARROLLO LOCAL del backend del chatbot.
#
#   cp .env.template .env
#
# Copiada tal cual, la app arranca y funciona: base de datos local y todos los
# módulos externos (Seguridad, Productos, Ventas, Despacho) en modo fake.
#
# Regla del proyecto:
#   - Lo que NO es secreto se versiona aquí, con valores que funcionan.
#   - Lo que SÍ es secreto (LLM_API_KEY, SECURITY_CLIENT_SECRET, SMTP_PASSWORD)
#     se pide al vault del equipo y NUNCA se escribe en este archivo.
#
# Guía completa (quién entrega cada valor): docs/entorno.md
# =============================================================================

# --- Base de datos (obligatoria) --------------------------------------------
# PostgreSQL 18. La forma más rápida en local:
#   docker run -d --name chatbot-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=chatbot -p 5432:5432 postgres:18
#   alembic upgrade head
# Si se apunta a Supabase/Railway, esta URL contiene contraseña: va al vault,
# no a este archivo.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot

# --- Aplicación --------------------------------------------------------------
APP_ENV=development
# Cookie de sesión: false en local por HTTP; true en cualquier despliegue HTTPS.
COOKIE_SECURE=false
# Orígenes exactos permitidos en los endpoints de sesión (check CSRF por Origin).
ALLOWED_ORIGINS=http://localhost:3000
# Base de los deep links del correo (/pedidos/{id}).
FRONTEND_BASE_URL=http://localhost:3000
ASSISTANT_NAME=Botleta

# --- Módulos externos --------------------------------------------------------
# fake = adaptador en memoria, sin red (no hace falta nada más).
# http = cliente real contra *_BASE_URL (y credenciales, si el módulo las pide).
#
# PERFIL LOCAL (por defecto): todo fake. Es el que funciona recién clonado.
MODULES_MODE=fake
SECURITY_MODE=fake
PRODUCTS_MODE=fake
PRODUCTS_AUTH_MODE=service
ALLOW_PUBLIC_PRODUCTS=false
SALES_MODE=fake
DISPATCH_MODE=fake

# URLs y timeouts locales (perfil fake o mocks).
SECURITY_BASE_URL=http://localhost:4010
SECURITY_EXPECTED_ISSUER=auth-service
PRODUCTS_BASE_URL=http://localhost:4011
SALES_BASE_URL=http://localhost:4012
DISPATCH_BASE_URL=http://localhost:4013
SECURITY_TIMEOUT_SECONDS=5
PRODUCTS_TIMEOUT_SECONDS=4
SALES_TIMEOUT_SECONDS=5
DISPATCH_TIMEOUT_SECONDS=4

# Credenciales de módulos: solo se usan con el perfil real.
SECURITY_CLIENT_ID=modulo-chatbot
# Secreto del cliente OAuth (POST /auth/token). Nunca escribirlo aquí.
SECURITY_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# PERFIL REAL (G7, G6 y G2 desplegados). Para usarlo, descomentar TODAS estas
# líneas: van después de las locales, así que las reemplazan. Son valores no
# secretos (URLs, modos, timeouts) y por eso se versionan.
# -----------------------------------------------------------------------------
# MODULES_MODE=http
# SECURITY_MODE=http
# PRODUCTS_MODE=http
# SALES_MODE=fake              # Ventas (G5) no está desplegado para el chatbot
# DISPATCH_MODE=http
# PRODUCTS_AUTH_MODE=public
# ALLOW_PUBLIC_PRODUCTS=true   # obligatorio con AUTH_MODE=public en producción
# SECURITY_BASE_URL=https://g7-auth-service.onrender.com/api/v1
# SECURITY_EXPECTED_ISSUER=https://g7-auth-service.onrender.com/api/v1/auth
# PRODUCTS_BASE_URL=https://api-gateway.calmgrass-aec0b33c.chilecentral.azurecontainerapps.io/api/v1
# DISPATCH_BASE_URL=https://taller-api-gateway.onrender.com/api/v1
# Render Free tarda hasta 180 s en el primer request (cold start).
# SECURITY_TIMEOUT_SECONDS=30
# PRODUCTS_TIMEOUT_SECONDS=10
# SALES_TIMEOUT_SECONDS=180
# DISPATCH_TIMEOUT_SECONDS=15


# --- LLM (ADR-0005) ----------------------------------------------------------
# La app arranca sin clave; el chat falla solo cuando se usa.
# Para probar el chat hace falta una clave del vault del equipo.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=15
LLM_VISION_ENABLED=true
# none | minimal | low | medium | high. Cualquier valor distinto de none anula
# LLM_TEMPERATURE y usa el del modelo.
LLM_REASONING_EFFORT=none
# Secreto: pedirlo al vault. Nunca commitear una clave real.
LLM_API_KEY=

# --- Correo de confirmación (SPEC-16) ---------------------------------------
# Sin SMTP_HOST se usa el remitente en memoria: no se envía nada, pero el flujo
# completo funciona. Para probar correos reales, sandbox de Mailtrap:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Secreto: pedirlo al vault.
SMTP_PASSWORD=
SMTP_FROM=Botleta <no-reply@g3-chatbot.local>
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# true: envía al encolar; false: solo el worker del outbox.
NOTIFICATION_SEND_INLINE=true

# --- Outbox ------------------------------------------------------------------
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5
