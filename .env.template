# =============================================================================
# Plantilla de entorno para DESARROLLO LOCAL del backend del chatbot.
#
#   cp .env.template .env
#
# Copiada tal cual, la app arranca y funciona: base de datos local y todos los
# módulos externos (Seguridad, Productos, Ventas, Despacho) en modo fake.
#
# Regla del proyecto:
#   - Lo que NO es secreto se versiona aquí, con valores que funcionan.
#   - Lo que SÍ es secreto (LLM_API_KEY, SECURITY_CLIENT_SECRET, SMTP_PASSWORD)
#     se pide al vault del equipo y NUNCA se escribe en este archivo.
#
# Guía completa (quién entrega cada valor): docs/entorno.md
# =============================================================================

# --- Base de datos (obligatoria) --------------------------------------------
# PostgreSQL 18. La forma más rápida en local:
#   docker run -d --name chatbot-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=chatbot -p 5432:5432 postgres:18
#   alembic upgrade head
# Si se apunta a Supabase/Railway, esta URL contiene contraseña: va al vault,
# no a este archivo.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot

# --- Aplicación --------------------------------------------------------------
# En producción poner APP_ENV=production: la app se niega a arrancar con MODO_QA,
# secretos de desarrollo (PHONE_OTP_SECRET, ATTACHMENT_SIGNING_SECRET, sin fallback entre
# ellos), URLs localhost (FRONTEND_BASE_URL, ATTACHMENT_PUBLIC_BASE_URL, ALLOWED_ORIGINS y
# las URLs de módulos en modo http), COOKIE_SECURE=false, SECURITY_EXPECTED_ISSUER sin definir
# o ATTACHMENT_STORAGE=local sin ALLOW_LOCAL_ATTACHMENTS=true.
# Con APP_ENV vacío o distinto de production se registra un WARNING al arrancar con la lista.
APP_ENV=development
# Cookie de sesión: false en local por HTTP; true en cualquier despliegue HTTPS.
COOKIE_SECURE=false
# Orígenes exactos permitidos en los endpoints de sesión (check CSRF por Origin).
ALLOWED_ORIGINS=http://localhost:3000
# Base de los deep links del correo (/pedidos/{id}).
FRONTEND_BASE_URL=http://localhost:3000
ASSISTANT_NAME=Botleta

# --- Módulos externos --------------------------------------------------------
# fake = adaptador en memoria, sin red (no hace falta nada más).
# http = cliente real contra *_BASE_URL (y credenciales, si el módulo las pide).
#
# PERFIL LOCAL (por defecto): todo fake. Es el que funciona recién clonado.
MODULES_MODE=fake
SECURITY_MODE=fake
PRODUCTS_MODE=fake
PRODUCTS_AUTH_MODE=service
ALLOW_PUBLIC_PRODUCTS=false
SALES_MODE=fake
DISPATCH_MODE=fake

# URLs y timeouts locales (perfil fake o mocks).
SECURITY_BASE_URL=http://localhost:4010
SECURITY_EXPECTED_ISSUER=auth-service
PRODUCTS_BASE_URL=http://localhost:4011
SALES_BASE_URL=http://localhost:4012
POSTVENTA_BASE_URL=http://localhost:8082
DISPATCH_BASE_URL=http://localhost:4013
SECURITY_TIMEOUT_SECONDS=5
PRODUCTS_TIMEOUT_SECONDS=4
SALES_TIMEOUT_SECONDS=5
POSTVENTA_TIMEOUT_SECONDS=5
DISPATCH_TIMEOUT_SECONDS=4

# Credenciales de módulos: solo se usan con el perfil real.
SECURITY_CLIENT_ID=modulo-chatbot
# Secreto del cliente OAuth (POST /auth/token). Nunca escribirlo aquí.
SECURITY_CLIENT_SECRET=
# En APP_ENV=production el fake de Seguridad se rechaza salvo que esto sea true
# (opt-in explícito, p. ej. un deploy demo). En local no hace falta.
# ALLOW_FAKE_SECURITY=false
# En APP_ENV=production los fakes de Productos/Ventas/Despacho también se rechazan.
# Si de verdad necesitas un demo con datos en memoria, el opt-in explícito es
# ALLOW_FAKE_MODULES=true; /health responderá status=degraded y fakeModules.
# ALLOW_FAKE_MODULES=false

# -----------------------------------------------------------------------------
# PERFIL REAL (G7, G6 y G2 desplegados). Para usarlo, descomentar TODAS estas
# líneas: van después de las locales, así que las reemplazan. Son valores no
# secretos (URLs, modos, timeouts) y por eso se versionan.
# -----------------------------------------------------------------------------
# MODULES_MODE=http
# SECURITY_MODE=http
# PRODUCTS_MODE=http
# G5 Ventas/Postventa: usar M1 y M2 directos. El gateway público tiene el
# challenge de Cloudflare de Render Free y no se recomienda para server-to-server.
# SALES_MODE=http
# SALES_BASE_URL=https://g5-servicio-ventas.onrender.com
# POSTVENTA_BASE_URL=https://g5-ventas-postventas-backend.onrender.com
# DISPATCH_MODE=http
# PRODUCTS_AUTH_MODE=public
# Obligatorio con AUTH_MODE=public en producción.
# ALLOW_PUBLIC_PRODUCTS=true
# SECURITY_BASE_URL=https://g7-auth-service.onrender.com/api/v1
# SECURITY_EXPECTED_ISSUER=https://g7-auth-service.onrender.com/api/v1/auth
# PRODUCTS_BASE_URL=https://api-gateway.calmgrass-aec0b33c.chilecentral.azurecontainerapps.io/api/v1
# DISPATCH_BASE_URL=https://taller-api-gateway.onrender.com/api/v1
# Render Free tarda hasta 180 s en el primer request (cold start).
# SECURITY_TIMEOUT_SECONDS=30
# PRODUCTS_TIMEOUT_SECONDS=10
# SALES_TIMEOUT_SECONDS=180
# POSTVENTA_TIMEOUT_SECONDS=180
# DISPATCH_TIMEOUT_SECONDS=15
# El deadline de POST /checkout no se iguala a SALES_TIMEOUT_SECONDS: se mantiene
# en 30 s para responder antes de que el cliente/proxy corte a los 120 s.
# CHECKOUT_SALES_DEADLINE_SECONDS=30


# --- LLM (ADR-0005) ----------------------------------------------------------
# La app arranca sin clave; el chat falla solo cuando se usa.
# Para probar el chat hace falta una clave del vault del equipo.
# LLM_PROVIDER: openai | fake. fake = guion fijo sin red, solo para las pruebas
# de carga (tests/performance/k6); la app se niega a usarlo con APP_ENV=production.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=15
LLM_VISION_ENABLED=true
# none | minimal | low | medium | high. Cualquier valor distinto de none anula
# LLM_TEMPERATURE y usa el del modelo.
LLM_REASONING_EFFORT=none
# Secreto: pedirlo al vault. Nunca commitear una clave real.
LLM_API_KEY=

# --- Correo de confirmación (SPEC-16) ---------------------------------------
# Sin SMTP_HOST se usa el remitente en memoria: no se envía nada, pero el flujo
# completo funciona. Para probar correos reales, sandbox de Mailtrap:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Secreto: pedirlo al vault.
SMTP_PASSWORD=
SMTP_FROM=Botleta <no-reply@g3-chatbot.local>
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# true: envía al encolar; false: solo el worker del outbox.
NOTIFICATION_SEND_INLINE=true

# --- Outbox ------------------------------------------------------------------
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5
# Barrido ExpirarCheckouts (SPEC-14): expira checkouts vencidos y cancela el pedido en Ventas.
CHECKOUT_EXPIRY_INTERVAL_SECONDS=60
# Retención de conversaciones (SPEC-05, #252): cierra anónimas >7d y archiva clientes >90d.
CONVERSATION_RETENTION_INTERVAL_SECONDS=3600
# Deadline interno de POST /checkout -> POST /pedidos de Ventas. El cliente/proxy
# del frontend corta a los 120 s y el cold start de G5 puede superarlo: 30 s deja
# margen para el resto del checkout y convierte el timeout en un 503 recuperable
# con checkoutId y orderId (ver docs/checkout-consistencia.md).
CHECKOUT_SALES_DEADLINE_SECONDS=30

# --- Verificación del contacto en checkout (SPEC-04) -------------------------
# Guard por contacto verificado: correo del perfil (verificado al registrarse) o
# celular verificado localmente como respaldo. Default true en producción y
# false en desarrollo/fake.
# REQUIRE_VERIFIED_CONTACT=true
# Modo legado (solo celular), opt-in. Si es true, tiene precedencia sobre el
# flag de contacto verificado.
# REQUIRE_PHONE_VERIFICATION=false
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_MAX_ATTEMPTS=3
PHONE_OTP_MAX_SENDS=3
PHONE_OTP_SEND_WINDOW_SECONDS=900
# Secreto HMAC de los códigos. Obligatorio en production; en desarrollo vacío usa SECURITY_CLIENT_SECRET o el valor de dev.
PHONE_OTP_SECRET=
# Solo pruebas: devuelve el código en la respuesta de solicitar-otp.
MODO_QA=false

# --- Guardado opcional de dirección (SPEC-12) --------------------------------
# true: si el cliente marca "Guardar esta dirección", el checkout la envía a
# Seguridad; un fallo de Seguridad solo avisa, nunca bloquea el checkout.
CHECKOUT_SAVE_ADDRESS_ENABLED=true

# --- Retroalimentación (SPEC-24) ---------------------------------------------
# Bandeja interna que recibe sugerencias y bugs.
FEEDBACK_INBOX_EMAIL=soporte@g3-chatbot.local

# --- Adjuntos del chat (SPEC-23) ---------------------------------------------
# local (por defecto): disco del contenedor, efímero en Railway; solo para desarrollo.
# supabase: bucket PRIVADO de Supabase Storage (ADR-0028). Crear el bucket antes de activarlo.
# En APP_ENV=production con local el arranque FALLA (fail-closed). La única excepción es
# ALLOW_LOCAL_ATTACHMENTS=true, aceptada explícitamente por el PO; en ese caso se registra un
# WARNING y los adjuntos se pierden al recrear el servicio.
ATTACHMENT_STORAGE=local
# ALLOW_LOCAL_ATTACHMENTS=false
ATTACHMENT_STORAGE_PATH=var/attachments
# Solo con ATTACHMENT_STORAGE=supabase. SUPABASE_SERVICE_KEY es secreto: va al vault.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ATTACHMENT_BUCKET=chat-attachments
ATTACHMENT_STORAGE_TIMEOUT_SECONDS=10
ATTACHMENT_PUBLIC_BASE_URL=http://localhost:8000/api/v1
# Secreto HMAC de las URLs firmadas. Obligatorio en production (sin fallback); en desarrollo vacío usa PHONE_OTP_SECRET/SECURITY_CLIENT_SECRET.
ATTACHMENT_SIGNING_SECRET=
ATTACHMENT_SIGNED_URL_TTL_SECONDS=300
ATTACHMENT_MAX_IMAGES_PER_TURN=6
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=3600

# Outbox relay (ADR-0030)
# direct = worker en proceso (default y rollback); broker = publica en RabbitMQ.
OUTBOX_DISPATCH_MODE=direct
# URL con credenciales (amqp:// o amqps://). Solo en Railway/Vault; nunca en el repo.
RABBITMQ_URL=
RABBITMQ_PREFETCH=10

# --- API Gateway Kong OSS (ADR-0031, #256) ----------------------------------
# Secreto compartido inyectado por Kong en X-Gateway-Secret. Cuando tiene valor,
# FastAPI rechaza con 403 GATEWAY_REQUIRED cualquier petición directa que no venga
# del gateway. Configurar el mismo valor en el servicio Kong y en el backend en Railway.
GATEWAY_SHARED_SECRET=
