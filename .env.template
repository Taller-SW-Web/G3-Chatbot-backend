
DATABASE_URL=

# Secure flag of the chat_sid cookie; set to false only for plain-HTTP local development
COOKIE_SECURE=true

# Comma-separated exact origins allowed on the mutating session endpoints (CSRF Origin check)
ALLOWED_ORIGINS=http://localhost:3000

# LLM (ADR-0005). None of these is required to start the app.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=15
# Never commit a real key. Leave empty in the template.
LLM_API_KEY=
LLM_VISION_ENABLED=true
# none | minimal | low | medium | high. Anything but none disables LLM_TEMPERATURE (model default is used).
LLM_REASONING_EFFORT=none

ASSISTANT_NAME=Botleta

# In-process module fakes for deployed environments without real modules
# (ADR-0022): fake | http. Environment values belong to the deploy track.
MODULES_MODE=http

# Module base URLs (H3-05, ADR-0017): mock or real per environment.
SECURITY_BASE_URL=http://localhost:4010
# Expected `iss` of access tokens. Real G7: https://g7-auth-service.onrender.com/api/v1/auth
SECURITY_EXPECTED_ISSUER=auth-service
# Client secret: sent only to POST /auth/token (service token provider), never as a header.
SECURITY_CLIENT_SECRET=secreto-de-prueba
# OAuth client id used for the service token (/auth/token, client_credentials).
SECURITY_CLIENT_ID=modulo-chatbot
PRODUCTS_BASE_URL=http://localhost:4011
# Ventas G5: real en https://g5-api-gateway.onrender.com (mock local http://localhost:4012)
SALES_BASE_URL=https://g5-api-gateway.onrender.com
DISPATCH_BASE_URL=http://localhost:4013
SECURITY_TIMEOUT_SECONDS=5
PRODUCTS_TIMEOUT_SECONDS=4
# Render Free: cold start puede tomar hasta 180s en la primera petición
SALES_TIMEOUT_SECONDS=180
DISPATCH_TIMEOUT_SECONDS=4

# Order confirmation e-mail (SPEC-16). Empty SMTP_HOST = in-memory fake sender (nothing is delivered).
# Development: Mailtrap sandbox (host sandbox.smtp.mailtrap.io, port 2525, credentials from the inbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Never commit a real password. Leave empty in the template.
SMTP_PASSWORD=
SMTP_FROM=Botleta <no-reply@g3-chatbot.local>
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# Base URL of the deep link /pedidos/{pedidoId} in the e-mail
FRONTEND_BASE_URL=http://localhost:3000
# true: send right after enqueueing (no outbox worker yet, SPEC-15). false: only the worker sends.
NOTIFICATION_SEND_INLINE=true